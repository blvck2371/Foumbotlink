{
  "name": "foumbotlink-functions",
  "description": "Cloud Functions Foumbot Link — notifications d'appel (FCM), activité sociale, modération et marché",
  "private": true,
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "scripts": {
    "serve": "firebase emulators:start --only functions",
    "logs": "firebase functions:log",
    "deploy": "firebase deploy --only functions",
    "migrate:likes": "node scripts/migrate_likes.js",
    "test:rules": "firebase emulators:exec --only firestore --project demo-rules \"node scripts/test_rules_likes.js\"",
    "test:rules:typing": "firebase emulators:exec --only firestore --project demo-rules \"node scripts/test_rules_typing.js\"",
    "test:migration": "firebase emulators:exec --only firestore --project demo-migration \"node scripts/test_migrate_likes.js\"",
    "migrate:market": "node scripts/migrate_market.js",
    "test:rules:market": "firebase emulators:exec --only firestore --project demo-rules \"node scripts/test_rules_market.js\"",
    "test:backfill": "firebase emulators:exec --only firestore --project demo-backfill \"node scripts/test_backfill_market.js\"",
    "test:rules:statuses": "firebase emulators:exec --only firestore --project demo-rules \"node scripts/test_rules_statuses.js\"",
    "test:rules:status": "firebase emulators:exec --only firestore --project demo-rules \"node scripts/test_rules_status.js\"",
    "test:rules:dossiers": "firebase emulators:exec --only firestore --project demo-rules \"node scripts/test_rules_dossiers.js\"",
    "test:rules:all": "firebase emulators:exec --only firestore --project demo-rules \"node scripts/test_rules_likes.js && node scripts/test_rules_typing.js && node scripts/test_rules_market.js && node scripts/test_rules_status.js && node scripts/test_rules_dossiers.js && node scripts/test_rules_counters.js && node scripts/test_rules_blocking.js && node scripts/test_rules_reports.js && node scripts/test_backfill_market.js\"",
    "test:rules:counters": "firebase emulators:exec --only firestore --project demo-rules \"node scripts/test_rules_counters.js\"",
    "test:delete-account": "firebase emulators:exec --only firestore,auth,storage --project demo-delete \"node scripts/test_delete_account.js\"",
    "test:rules:blocking": "firebase emulators:exec --only firestore --project demo-rules \"node scripts/test_rules_blocking.js\"",
    "test:block": "firebase emulators:exec --only firestore,auth --project demo-block \"node scripts/test_block_function.js && node scripts/test_report_function.js\"",
    "test:rules:reports": "firebase emulators:exec --only firestore --project demo-rules \"node scripts/test_rules_reports.js\"",
    "test:chat": "firebase emulators:exec --only firestore,storage --project demo-chat \"node scripts/test_chat_end_to_end.js\""
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "firebase-functions": "^7.3.2"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.18.0"
  }
}
