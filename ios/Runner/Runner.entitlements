<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Push (APNs). Passer à "production" pour une build App Store.
	     Ce fichier n'est pris en compte que lorsqu'il est référencé par
	     CODE_SIGN_ENTITLEMENTS dans le projet Xcode (voir Signing &
	     Capabilities → Push Notifications) — dormant sans compte Apple. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
