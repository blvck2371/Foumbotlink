<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>NSContactsUsageDescription</key>
	<string>Foumbot Link compare votre répertoire pour vous proposer les habitants que vous connaissez déjà. Vos numéros ne sont jamais envoyés en clair : seule une empreinte de chacun est comparée, et rien n’est conservé.</string>
	<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>Foumbot Link</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>foumbotlik</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<!-- Appels entrants : réveil par push VoIP/silencieux, audio WebRTC en
		     arrière-plan. Inactif tant que la clé APNs n'est pas envoyée à
		     Firebase et que les capabilities Push/Background ne sont pas
		     activées dans Xcode (compte Apple Developer requis). -->
		<key>UIBackgroundModes</key>
		<array>
			<string>audio</string>
			<string>voip</string>
			<string>remote-notification</string>
			<string>fetch</string>
		</array>
		<key>NSMicrophoneUsageDescription</key>
		<string>Foumbot Link a besoin du micro pour enregistrer des messages vocaux et passer des appels.</string>
		<key>NSCameraUsageDescription</key>
		<string>Foumbot Link utilise la caméra pour les appels vidéo, les photos et la lecture du QR code de suivi des dossiers au guichet.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>Foumbot Link a besoin d’accéder à vos photos pour les joindre à une publication.</string>
		<key>UIApplicationSceneManifest</key>
		<dict>
			<key>UIApplicationSupportsMultipleScenes</key>
			<false/>
			<key>UISceneConfigurations</key>
			<dict>
				<key>UIWindowSceneSessionRoleApplication</key>
				<array>
					<dict>
						<key>UISceneClassName</key>
						<string>UIWindowScene</string>
						<key>UISceneConfigurationName</key>
						<string>flutter</string>
						<key>UISceneDelegateClassName</key>
						<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
						<key>UISceneStoryboardFile</key>
						<string>Main</string>
					</dict>
				</array>
			</dict>
		</dict>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UIStatusBarHidden</key>
		<true/>
		<key>UIViewControllerBasedStatusBarAppearance</key>
		<false/>
		<!-- url_launcher : schémas que l'app doit pouvoir ouvrir depuis le
		     Marché (appel, SMS, WhatsApp, liens web). -->
		<key>LSApplicationQueriesSchemes</key>
		<array>
			<string>tel</string>
			<string>sms</string>
			<string>https</string>
			<string>http</string>
			<string>whatsapp</string>
		</array>
	</dict>
</plist>
