rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Un compteur écrit par un tiers ne peut bouger que d'un cran.
    // `direction` vaut 1 pour un compteur qui ne fait que monter (vues,
    // contacts), 0 pour un compteur qui monte et descend (favoris :
    // on met de côté, puis on retire). Un champ non modifié passe
    // toujours, et un champ absent du document part de 0.
    function counterStep(before, after, field, direction) {
      return !after.data.diff(before.data).affectedKeys().hasAny([field])
        || after.data.get(field, 0) == before.data.get(field, 0) + 1
        || (direction == 0
            && after.data.get(field, 0) == before.data.get(field, 0) - 1);
    }

    // Blocage, dans un sens ou dans l'autre, entre `a` et `b`. La liste
    // `users/{uid}/blocked` est privée à son propriétaire, mais les règles
    // la lisent quand même : c'est ici, et non dans l'app, que le blocage
    // devient une vraie barrière (messages, appels, commentaires,
    // abonnements, avis).
    function blockedBetween(a, b) {
      return exists(/databases/$(database)/documents/users/$(a)/blocked/$(b))
        || exists(/databases/$(database)/documents/users/$(b)/blocked/$(a));
    }

    // Une conversation privée a pour id `uidA_uidB` (uids triés, voir
    // Conversation.buildId) ; un uid Firebase ne contient jamais `_`. On
    // en déduit les participants sans lire le document, qui n'existe
    // peut-être pas encore quand le premier message part.
    function conversationPeers(conversationId) {
      return conversationId.split('_');
    }

    function canWriteConversation(conversationId) {
      let peers = conversationPeers(conversationId);
      return request.auth != null
        && peers.size() == 2
        && request.auth.uid in peers
        && !blockedBetween(peers[0], peers[1]);
    }

    // -----------------------------------------------------------------
    // Profils utilisateurs
    // -----------------------------------------------------------------
    match /users/{uid} {
      // `followersCount` ne bouge que d'un cran, et seulement dans la
      // même écriture que l'abonnement qui le justifie : +1 quand
      // `followers/{moi}` apparaît, −1 quand il disparaît (batch de
      // follow_service.dart). Sans ce lien, n'importe quel compte
      // connecté pouvait inscrire un nombre d'abonnés arbitraire sur le
      // profil d'autrui — ou le sien.
      function followersCountMatchesEdge() {
        let before = resource.data.get('followersCount', 0);
        let after = request.resource.data.get('followersCount', 0);
        let edge = /databases/$(database)/documents/users/$(uid)/followers/$(request.auth.uid);
        return after == before
          || (after == before + 1 && !exists(edge) && existsAfter(edge))
          || (after == before - 1 && exists(edge) && !existsAfter(edge));
      }

      allow read: if request.auth != null;

      // Un profil naît à zéro abonné : sinon il suffirait de le créer
      // avec les compteurs déjà gonflés.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.verified == false
        && request.resource.data.get('followersCount', 0) == 0
        && request.resource.data.get('followingCount', 0) == 0;

      // Le propriétaire peut modifier son propre profil librement (hors
      // verified/accountType, contrôlés côté admin, et hors compteurs).
      // Un autre utilisateur ne peut toucher que `followersCount` — c'est
      // le seul champ que follow_service.dart écrit sur le document
      // d'autrui (batch follow/unfollow) ; tout le reste du document doit
      // rester intact.
      allow update: if request.auth != null
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.accountType == resource.data.accountType
        && followersCountMatchesEdge()
        && (
          (request.auth.uid == uid
            && counterStep(resource, request.resource, 'followingCount', 0))
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['followersCount'])
        );

      // Données privées du compte, jamais lisibles par un tiers — en
      // particulier `push` = { tokens: [...] } (jetons FCM utilisés par les
      // Cloud Functions pour notifier un appel entrant / un appel manqué).
      // Les Functions y accèdent via l'Admin SDK, qui ignore ces règles.
      match /private/{docId} {
        allow read: if request.auth != null
          && request.auth.uid == uid;
        allow write: if request.auth != null
          && request.auth.uid == uid
          && docId != 'tracking';
      }

      // Le code de suivi tel que son propriétaire le voit. Écrit une
      // seule fois, dans le même batch que `trackingCodes/{code}`, et
      // jamais modifié ni effacé : c'est ce verrou qui borne chaque
      // compte à un seul code (voir `trackingCodes` plus bas).
      match /private/tracking {
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.code is string
          && existsAfter(/databases/$(database)/documents/trackingCodes/$(request.resource.data.code))
          && getAfter(/databases/$(database)/documents/trackingCodes/$(request.resource.data.code))
               .data.uid == uid;
        allow update, delete: if false;
      }

      // Flux personnel (message reçu, like, commentaire, nouvel abonné,
      // publication d'un compte suivi, appel manqué...) — jamais visible
      // par un tiers. Normalement créé par les Cloud Functions (Admin SDK,
      // ignore ces règles) ; seule exception, la notif de mise à jour
      // disponible, écrite par le client lui-même après comparaison de
      // version (voir NotificationService.checkAppUpdate).
      match /notifications/{notificationId} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.type == 'appUpdate';
        // Seul le statut lu/non lu est modifiable par le propriétaire.
        allow update: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['read']);
      }

      // Liste de blocage — strictement privée à son propriétaire : la
      // personne bloquée ne doit jamais pouvoir savoir qu'elle l'est.
      // Sert à filtrer le fil et les commentaires côté client
      // (ModerationService).
      match /blocked/{blockedUid} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid;
      }

      // Miroir de `blocked`, tenu par le serveur (`onBlockWritten`) : qui
      // m'a bloqué. Lisible par moi seul, pour que mon app masque à son
      // tour ses contenus ; personne ne l'écrit à la main.
      match /blockedBy/{blockerUid} {
        allow read: if request.auth != null && request.auth.uid == uid;
        allow write: if false;
      }

      // Se désabonner reste toujours possible ; s'abonner, non, entre
      // deux comptes dont l'un a bloqué l'autre.
      match /followers/{followerUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == followerUid
          && !blockedBetween(uid, followerUid);
        allow delete: if request.auth != null
          && request.auth.uid == followerUid;
      }

      match /following/{targetUid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == uid
          && !blockedBetween(uid, targetUid);
        allow delete: if request.auth != null
          && request.auth.uid == uid;
      }

      // Miroir des posts aimés — `users/{uid}/likes/{postId}`. Doublon
      // assumé de `posts/{postId}/likes/{uid}` : il permet de charger « ce
      // que j'ai aimé » en une requête, là où la sous-collection du post
      // répond à « qui a aimé ce post ». Strictement personnel.
      match /likes/{postId} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid;
      }

      // Statuts déjà vus — `users/{uid}/statusViews/{statusId}`. Miroir
      // strictement personnel, calqué sur celui des likes : il sert à
      // savoir d'une seule requête quels statuts ne doivent plus
      // apparaître comme neufs.
      match /statusViews/{statusId} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid;
      }

      // Statuts aimés — `users/{uid}/statusLikes/{statusId}`. Même miroir
      // personnel : savoir ce que *j'ai* aimé tient en une requête, là où
      // interroger chaque statut en coûterait une par statut affiché. La
      // vérité publique reste `statuses/{id}/likes/{uid}`.
      match /statusLikes/{statusId} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid;
      }

      // Publications mises de côté — `users/{uid}/saved/{postId}`. Même
      // forme que le miroir des likes ci-dessus, mais sans contrepartie
      // publique côté post : un enregistrement est privé, personne d'autre
      // que son auteur n'a à savoir ce qu'il a mis de côté.
      match /saved/{postId} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid;
      }

      // Annonces mises de côté — même logique que `saved`, côté marché.
      // Le compteur `favoritesCount` de l'annonce en est le seul reflet
      // public : personne ne peut savoir *qui* a mis quoi de côté.
      match /marketFavorites/{itemId} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid;
      }

      // Recherches enregistrées (alertes). Strictement personnelles ; les
      // Cloud Functions les relisent via l'Admin SDK, qui ignore ces
      // règles, pour rapprocher chaque nouvelle annonce des critères.
      match /savedSearches/{searchId} {
        allow read, write: if request.auth != null
          && request.auth.uid == uid;
      }

      // Trace « untel m'a contacté à propos d'une annonce ». Posée par
      // l'acheteur au moment où il révèle le numéro ou ouvre une
      // discussion. Elle n'est visible que des deux intéressés, et c'est
      // elle qui ouvre le droit de laisser un avis (voir plus bas).
      match /contactedBy/{buyerUid} {
        allow read: if request.auth != null
          && (request.auth.uid == uid || request.auth.uid == buyerUid);
        allow create, update: if request.auth != null
          && request.auth.uid == buyerUid;
        allow delete: if false;
      }

      // Avis sur un vendeur — `users/{uid}/reviews/{reviewerUid}`.
      //
      // Rien ne sécurise une transaction dans cette app : pas de
      // paiement, pas de séquestre, tout se règle en main propre. La
      // réputation est donc la seule information sur laquelle un
      // acheteur peut s'appuyer avant de se déplacer, et elle ne vaut
      // que si elle n'est pas falsifiable :
      //   - un document par auteur d'avis (l'id *est* son uid), donc
      //     pas de note répétée pour gonfler ou couler quelqu'un ;
      //   - on ne se note pas soi-même ;
      //   - il faut avoir réellement pris contact, ce que prouve
      //     `contactedBy`.
      // La moyenne affichée est recalculée côté serveur
      // (`onSellerReviewWritten`), jamais écrite par le client.
      match /reviews/{reviewerUid} {
        allow read: if request.auth != null;

        allow create, update: if request.auth != null
          && request.auth.uid == reviewerUid
          && reviewerUid != uid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment.size() <= 400
          && exists(/databases/$(database)/documents/users/$(uid)/contactedBy/$(request.auth.uid))
          && !blockedBetween(uid, reviewerUid);

        allow delete: if request.auth != null
          && request.auth.uid == reviewerUid;
      }
    }

    // -----------------------------------------------------------------
    // Annuaire des professionnels — `directory/{ownerUid}`
    //
    // Une fiche par compte (l'id *est* l'uid du propriétaire). Lisible
    // par tous, y compris sans compte ; le numéro, lui, vit dans
    // `contact/main`, réservé aux comptes connectés (même raison que pour
    // le marché : un document public suffirait à aspirer les numéros de
    // la commune).
    //
    // Le classement repose sur `rankScore`, une moyenne bayésienne
    // recalculée par `onProReviewWritten`. Le propriétaire ne touche
    // jamais aux champs de réputation : à la création ils sont imposés à
    // leur valeur neutre (3,5 = ProListing.rankPrior), ensuite ils sont
    // hors de sa portée.
    // -----------------------------------------------------------------
    match /directory/{ownerUid} {
      function reputationKeys() {
        return ['ratingCount', 'ratingSum', 'ratingAvg', 'rankScore'];
      }

      function validListing(data) {
        return data.ownerUid == ownerUid
          && data.name is string
          && data.name.size() >= 2 && data.name.size() <= 60
          && data.category is string && data.category.size() <= 30
          && data.get('trade', '').size() <= 60
          && data.get('description', '').size() <= 600
          && data.get('quartier', '').size() <= 60
          && data.get('hours', '').size() <= 60
          && data.get('photos', []) is list
          && data.get('photos', []).size() <= 3;
      }

      allow read: if true;

      allow create: if request.auth != null
        && request.auth.uid == ownerUid
        && validListing(request.resource.data)
        && request.resource.data.ratingCount == 0
        && request.resource.data.ratingSum == 0
        && request.resource.data.ratingAvg == 0
        && request.resource.data.rankScore == 3.5;

      allow update: if request.auth != null
        && request.auth.uid == ownerUid
        && validListing(request.resource.data)
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(reputationKeys());

      allow delete: if request.auth != null && request.auth.uid == ownerUid;

      match /contact/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && request.auth.uid == ownerUid
          && docId == 'main';
      }

      // Trace d'une prise de contact (appel, WhatsApp, message) : c'est
      // elle qui ouvre le droit de noter. Visible des deux intéressés.
      match /contactedBy/{clientUid} {
        allow read: if request.auth != null
          && (request.auth.uid == ownerUid || request.auth.uid == clientUid);
        allow create, update: if request.auth != null
          && request.auth.uid == clientUid
          && clientUid != ownerUid;
        allow delete: if false;
      }

      // Avis — mêmes garde-fous que pour les vendeurs : un avis par
      // personne, pas d'auto-notation, contact préalable obligatoire.
      match /reviews/{reviewerUid} {
        allow read: if true;

        allow create, update: if request.auth != null
          && request.auth.uid == reviewerUid
          && reviewerUid != ownerUid
          && request.resource.data.rating is int
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && request.resource.data.comment is string
          && request.resource.data.comment.size() <= 400
          && request.resource.data.reviewerName is string
          && request.resource.data.reviewerName.size() <= 80
          && exists(/databases/$(database)/documents/directory/$(ownerUid)/contactedBy/$(request.auth.uid))
          && !blockedBetween(ownerUid, reviewerUid);

        allow delete: if request.auth != null
          && request.auth.uid == reviewerUid;
      }
    }

    // -----------------------------------------------------------------
    // Publications (fil d'actualité)
    // -----------------------------------------------------------------
    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid;

      // L'auteur peut modifier son post librement. Un autre utilisateur ne
      // peut toucher qu'au compteur de likes (setLike) ou à celui des
      // commentaires (addComment, appelé par l'auteur du commentaire, pas
      // forcément celui du post) — jamais au titre, corps ou auteur.
      //
      // `likesCount` n'est plus qu'un résumé : la vérité est l'existence
      // de `posts/{postId}/likes/{uid}`. Un tiers ne peut donc le décaler
      // que d'exactement un cran, ce qui interdit d'y écrire un nombre
      // arbitraire. `likedBy` a disparu du document.
      allow update: if request.auth != null
        && (
          resource.data.authorUid == request.auth.uid
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['likesCount'])
            && (
              request.resource.data.likesCount
                == resource.data.get('likesCount', 0) + 1
              || request.resource.data.likesCount
                == resource.data.get('likesCount', 0) - 1
            )
          )
          // Même borne pour les commentaires : un cran à la fois
          // (feed_service.addComment / _decrementCommentsCount), jamais
          // sous zéro.
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['commentsCount'])
            && counterStep(resource, request.resource, 'commentsCount', 0)
            && request.resource.data.get('commentsCount', 0) >= 0
          )
        );

      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;

      // Un document par personne ayant aimé — c'est *la* source de vérité
      // du like. Chacun ne peut poser ou retirer que le sien, et jamais le
      // modifier : un like n'a pas d'état intermédiaire, il existe ou non.
      match /likes/{likerUid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
          && request.auth.uid == likerUid;
        allow update: if false;
      }

      // Commentaires imbriqués
      match /comments/{commentId} {
        allow read: if true;

        // Le `get()` sur le post parent coûte une lecture par commentaire
        // écrit, mais c'est le seul moyen de faire respecter la fermeture
        // des commentaires : sans lui, « Fermer les commentaires » ne
        // serait qu'un masquage d'UI, contournable par n'importe quel
        // client. `commentsDisabled` est absent des posts créés avant
        // cette fonctionnalité, d'où le défaut à false.
        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && get(/databases/$(database)/documents/posts/$(postId))
               .data.get('commentsDisabled', false) == false
          && !blockedBetween(
               get(/databases/$(database)/documents/posts/$(postId))
                 .data.authorUid,
               request.auth.uid);

        // L'auteur peut modifier son commentaire librement. Un autre
        // utilisateur ne peut toucher qu'aux likes (setCommentLike).
        allow update: if request.auth != null
          && (
            resource.data.authorUid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['likedBy', 'likesCount'])
          );

        allow delete: if request.auth != null
          && resource.data.authorUid == request.auth.uid;
      }
    }

    // -----------------------------------------------------------------
    // Conversations (chat)
    // -----------------------------------------------------------------
    // -----------------------------------------------------------------
    // Suivi des dossiers déposés au guichet
    // -----------------------------------------------------------------

    /// Une structure **validée** — c'est-à-dire un compte que l'équipe a
    /// vérifié. Sans cette condition, n'importe qui pourrait se déclarer
    /// « structure » à l'inscription et se mettre à créer des dossiers au
    /// nom d'autrui.
    function isVerifiedStructure() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.accountType == 'structure'
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.verified == true;
    }

    // Annuaire inverse code → habitant. Lisible par les seules structures
    // validées : c'est ce qui permet au guichet de retrouver quelqu'un à
    // partir des sept caractères écrits sur sa chemise, et c'est aussi ce
    // qui empêche n'importe qui de balayer les codes pour dresser la
    // liste des habitants.
    // -----------------------------------------------------------------
    // Statuts éphémères (24 h)
    //
    // Lecture réservée aux comptes connectés : un statut n'est pas une
    // publication du fil, il s'adresse aux gens de l'app, et la liste de
    // ses spectateurs n'appartient qu'à son auteur.
    // -----------------------------------------------------------------
    match /statuses/{statusId} {
      allow read: if request.auth != null;

      // `viewsCount` doit partir de zéro : sans ça, on pourrait publier un
      // statut en s'attribuant d'emblée mille vues. Lu avec `get(...,-1)`
      // plutôt qu'en accès direct : un document sans le champ doit se voir
      // refusé proprement, là où l'accès direct fait échouer l'évaluation
      // de la règle elle-même (« Property viewsCount is undefined »).
      // L'échéance est bornée côté serveur : c'est elle qui décide de ce
      // qui reste visible et de ce que la purge ramasse. Sans cette borne,
      // un client bricolé pourrait se donner un statut permanent en
      // écrivant une date lointaine. 25 h plutôt que 24 pour tolérer
      // l'écart d'horloge de l'appareil, qui calcule cette date lui-même.
      // Un repartage doit dire de qui il vient : sans cette exigence, on
      // pourrait republier le contenu d'un autre en s'en attribuant la
      // paternité. L'affichage s'appuie sur ces champs pour la mention
      // « repartagé de … ».
      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid
        && request.resource.data.get('viewsCount', -1) == 0
        && request.resource.data.get('likesCount', 0) == 0
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.expiresAt
             < request.time + duration.value(25, 'h')
        && (
          !('repostOfId' in request.resource.data)
          || (
            request.resource.data.repostOfId is string
            && request.resource.data.repostOfAuthorUid is string
            && request.resource.data.repostOfAuthorUid.size() > 0
          )
        );

      // L'auteur reste maître de son statut. Un tiers ne peut toucher
      // qu'aux deux compteurs, et d'un seul cran — la vérité étant
      // l'existence de `views/{uid}` et de `likes/{uid}`, ces compteurs
      // n'en sont que le résumé. Les vues ne font que monter (on ne
      // « dé-voit » pas un statut) ; les « j'aime » se retirent, d'où la
      // direction libre pour eux seuls.
      allow update: if request.auth != null
        && (
          resource.data.authorUid == request.auth.uid
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['viewsCount', 'likesCount'])
            && counterStep(resource, request.resource, 'viewsCount', 1)
            && counterStep(resource, request.resource, 'likesCount', 0)
          )
        );

      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;

      // Un document par spectateur. Seul l'auteur du statut voit la liste
      // entière ; chacun peut relire la sienne, ce qui suffit au client
      // pour savoir s'il a déjà compté sa vue. Ni modification ni
      // suppression : une vue ne se reprend pas.
      match /views/{viewerUid} {
        allow read: if request.auth != null
          && (
            request.auth.uid == viewerUid
            || get(/databases/$(database)/documents/statuses/$(statusId))
                 .data.authorUid == request.auth.uid
          );
        allow create: if request.auth != null
          && request.auth.uid == viewerUid;
        allow update, delete: if false;
      }

      // Un document par personne ayant aimé — c'est *la* source de vérité
      // du « j'aime ». Chacun ne pose ou ne retire que le sien, et jamais
      // ne le modifie : un « j'aime » n'a pas d'état intermédiaire, il
      // existe ou non. Même découpage que `posts/{id}/likes/{uid}`.
      match /likes/{likerUid} {
        allow read: if request.auth != null
          && (
            request.auth.uid == likerUid
            || get(/databases/$(database)/documents/statuses/$(statusId))
                 .data.authorUid == request.auth.uid
          );
        allow create, delete: if request.auth != null
          && request.auth.uid == likerUid;
        allow update: if false;
      }
    }

    // -----------------------------------------------------------------
    // Démarches publiées par les structures
    //
    // Lecture publique : c'est un service au public, consultable sans
    // compte, comme le fil. L'écriture appartient à la seule structure
    // propriétaire — et seulement si elle est validée, sinon n'importe
    // qui se déclarant « structure » pourrait publier des tarifs et des
    // lieux officiels.
    // -----------------------------------------------------------------
    match /demarches/{demarcheId} {
      allow read: if true;

      allow create: if isVerifiedStructure()
        && request.resource.data.structureUid == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0;

      // `structureUid` est figé : une démarche ne change pas de guichet,
      // et l'y autoriser permettrait de déposer du contenu sur le compte
      // d'une autre structure.
      allow update: if isVerifiedStructure()
        && resource.data.structureUid == request.auth.uid
        && request.resource.data.structureUid == resource.data.structureUid;

      allow delete: if isVerifiedStructure()
        && resource.data.structureUid == request.auth.uid;
    }

    // Tendances de recherche : lues par tous, écrites uniquement par la
    // fonction `recordSearch` (qui compte une recherche par compte et par
    // jour). Le détail des comptes (`hits`) n'est lisible par personne.
    match /searchTrends/{key} {
      allow read: if true;
      allow write: if false;

      match /hits/{uid} {
        allow read, write: if false;
      }
    }

    match /trackingCodes/{code} {
      allow read: if isVerifiedStructure()
        || (request.auth != null && resource.data.uid == request.auth.uid);

      // Chacun ne réserve qu'un code pointant sur lui-même, et un code
      // déjà pris ne peut pas être repris : `create` échoue si le
      // document existe, ce qui garantit l'unicité sans transaction.
      //
      // **Un seul code par compte** : la réservation doit poser, dans le
      // même batch, `users/{moi}/private/tracking` — qui ne doit pas
      // encore exister et ne pourra plus jamais être effacé. Sans ce
      // verrou, un compte pouvait réserver des codes en boucle et
      // épuiser l'espace des codes.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/private/tracking)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/private/tracking)
             .data.code == code;

      // Un code attribué ne bouge plus : le réattribuer ferait basculer
      // les dossiers en cours d'un habitant vers un autre.
      allow update, delete: if false;
    }

    // -----------------------------------------------------------------
    // Annuaire d'empreintes de téléphone
    // -----------------------------------------------------------------
    //
    // Permet de retrouver quelqu'un à partir d'un numéro de son
    // répertoire, sans qu'aucun numéro ne circule en clair : la clé du
    // document est l'empreinte SHA-256 du numéro (voir PhoneContact).
    //
    // **Personne ne peut lire cette collection.** Ni le propriétaire, ni
    // un tiers, ni même un compte validé. Il n'y a que quelques dizaines
    // de millions de numéros camerounais possibles : lisible, l'annuaire
    // se reconstituerait par force brute en générant les empreintes de
    // tous les numéros. La comparaison se fait dans `matchContacts`, une
    // Cloud Function qui passe par l'Admin SDK et borne le nombre
    // d'empreintes par appel.
    // Décompte journalier des recherches de contacts, tenu par la Cloud
    // Function `matchContacts`.
    //
    // Fermé des deux côtés : lisible par personne, modifiable par
    // personne. Le laisser accessible à son propriétaire lui permettrait
    // de remettre son compteur à zéro depuis l'app, ce qui viderait la
    // protection de son sens.
    match /contactMatchQuota/{uid} {
      allow read, write: if false;
    }

    match /phoneDirectory/{hash} {
      allow read: if false;

      // Chacun n'inscrit qu'une empreinte pointant sur lui-même. Il n'a
      // pas à prouver qu'il possède le numéro — l'app le lui a fait
      // saisir — mais il ne peut pas en revendiquer un pour le compte
      // d'autrui.
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid;

      // Suppression réservée à celui qui l'a inscrite : retirer son
      // numéro doit le rendre introuvable, et personne ne doit pouvoir
      // rendre quelqu'un d'autre introuvable.
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
    }

    match /dossiers/{dossierId} {
      // Le propriétaire suit son dossier ; la structure qui l'a reçu le
      // traite. Personne d'autre n'y a accès — un dossier administratif
      // n'a pas à être public.
      allow read: if request.auth != null
        && (request.auth.uid == resource.data.ownerUid
            || request.auth.uid == resource.data.structureUid);

      // Seule une structure validée réceptionne, et seulement en son
      // propre nom.
      //
      // Surtout : **le dossier ne peut être rattaché qu'au compte
      // auquel le code appartient réellement.** La règle relit
      // l'annuaire et compare — sans quoi une structure pourrait
      // rattacher un dossier à n'importe qui, et cette personne verrait
      // apparaître une démarche qu'elle n'a jamais déposée.
      allow create: if isVerifiedStructure()
        && request.resource.data.structureUid == request.auth.uid
        && request.resource.data.status == 'receptionne'
        // Étapes de suivi définies par la structure : le dossier part
        // toujours de la première.
        && request.resource.data.get('stepIndex', 0) == 0
        && (!('steps' in request.resource.data)
            || (request.resource.data.steps is list
                && request.resource.data.steps.size() <= 20))
        && request.resource.data.title is string
        && request.resource.data.trackingCode is string
        && exists(/databases/$(database)/documents/trackingCodes/$(request.resource.data.trackingCode))
        && get(/databases/$(database)/documents/trackingCodes/$(request.resource.data.trackingCode))
             .data.uid == request.resource.data.ownerUid;

      // L'avancement appartient à la structure réceptrice. Le
      // propriétaire ne peut rien modifier : son dossier est le compte
      // rendu du service, pas un document qu'il rédige. Ni le
      // propriétaire, ni la structure, ni la date de dépôt ne changent
      // jamais.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.structureUid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.structureUid == resource.data.structureUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'updatedAt', 'events', 'reference', 'stepIndex'])
        && request.resource.data.get('stepIndex', 0) is int
        && request.resource.data.get('stepIndex', 0) >= 0;

      // Un dossier ne s'efface pas : il est la trace de ce qu'on a
      // déposé. Le ménage, s'il en faut un, revient à l'Admin SDK.
      allow delete: if false;
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if request.auth != null
        && request.resource.data.participants.size() == 2
        && request.resource.data.participants.toSet()
             == conversationPeers(conversationId).toSet()
        && canWriteConversation(conversationId);

      // Un participant ne peut toucher qu'aux métadonnées de conversation
      // écrites par chat_service.dart (aperçu du dernier message, réglage
      // "éphémère") — jamais à la liste des participants.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'lastMessage', 'lastMessageType', 'lastMessageAt',
               'lastMessageSenderUid', 'ephemeralSeconds', 'unreadCounts',
             ])
        // Le badge non lu est compté par le serveur (`onMessageCreated`).
        // Un participant ne peut que remettre **le sien** à zéro — jamais
        // toucher à celui de l'autre, ni se l'augmenter.
        && (
          !request.resource.data.diff(resource.data).affectedKeys()
            .hasAny(['unreadCounts'])
          || (
            request.resource.data.unreadCounts
              .diff(resource.data.get('unreadCounts', {}))
              .affectedKeys().hasOnly([request.auth.uid])
            && request.resource.data.unreadCounts[request.auth.uid] == 0
          )
        )
        // Remettre son badge à zéro reste possible malgré un blocage ;
        // l'aperçu du dernier message et le réglage éphémère, non — sans
        // quoi la personne bloquée écrirait encore dans la liste des
        // conversations de l'autre.
        && (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['unreadCounts'])
          || canWriteConversation(conversationId)
        );

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Il faut être l'un des deux participants — jusqu'ici, n'importe
        // quel compte connecté pouvait écrire dans n'importe quelle
        // conversation dont il devinait l'id — et qu'aucun des deux n'ait
        // bloqué l'autre.
        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid
          // Les traces d'appel sont écrites par le serveur seul.
          && request.resource.data.get('type', 'text') != 'call'
          && canWriteConversation(conversationId);

        // Après l'envoi, trois modifications seulement, et chacune est
        // bornée à ce que la personne a le droit de toucher.
        //
        // 1. L'accusé de lecture — n'importe quel participant.
        // 2. Sa propre réaction — la clé modifiée dans la carte
        //    `reactions` doit être son propre uid, sans quoi on pourrait
        //    poser une réaction au nom de l'autre.
        // 3. La suppression douce — l'expéditeur seul, et le contenu doit
        //    partir avec : `deleted: true` en gardant le texte laisserait
        //    un message « supprimé » toujours lisible dans la base.
        //
        // Jamais l'expéditeur, le type ni la date : ils restent figés.
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['readAt'])
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['reactions'])
              && request.resource.data.reactions
                   .diff(resource.data.get('reactions', {}))
                   .affectedKeys().hasOnly([request.auth.uid])
            )
            || (
              request.auth.uid == resource.data.senderUid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['deleted', 'content', 'fileName', 'durationMs',
                             'thumbUrl', 'reactions'])
              && request.resource.data.deleted == true
              && request.resource.data.content == ''
              // Retirer un message à tout le monde n'est offert que
              // pendant un délai après l'envoi (voir
              // ChatMessage.deleteForEveryoneWindow). Passé ce délai, il a
              // été lu, cité, peut-être capturé : l'effacer de l'écran
              // d'en face donnerait une fausse impression d'effacement.
              // L'app masque déjà l'option ; la règle est ce qui la rend
              // vraie.
              && request.time < resource.data.createdAt + duration.value(60, 'h')
            )
            // Consommation d'un message à vue unique. C'est le
            // **destinataire** qui écrit, et seulement lui : l'expéditeur
            // brûlerait son propre message avant que l'autre l'ait vu.
            //
            // Une seule fois — `viewOnceOpenedAt` doit être absent avant
            // l'écriture — et le contenu part dans le même geste, pour que
            // l'URL ne reste pas lisible dans la base à qui saurait l'y
            // chercher. Voir ChatService.consumeViewOnce.
            || (
              resource.data.get('viewOnce', false) == true
              && !resource.data.keys().hasAny(['viewOnceOpenedAt'])
              && request.auth.uid != resource.data.senderUid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['viewOnceOpenedAt', 'content', 'thumbUrl'])
              && request.resource.data.viewOnceOpenedAt == request.time
              && request.resource.data.content == ''
              && !request.resource.data.keys().hasAny(['thumbUrl'])
            )
            // Signalement d'une capture d'écran sur un message à vue
            // unique. Écrit par le destinataire, une seule fois, et lu
            // par l'expéditeur. On ne peut pas empêcher la capture sur
            // iOS — le système ne prévient qu'après —, mais celui qui a
            // envoyé a le droit de l'apprendre.
            || (
              resource.data.get('viewOnce', false) == true
              && !resource.data.keys().hasAny(['screenshotAt'])
              && request.auth.uid != resource.data.senderUid
              && request.resource.data.diff(resource.data).affectedKeys()
                   .hasOnly(['screenshotAt'])
              && request.resource.data.screenshotAt == request.time
            )
            // « Supprimer pour moi » : chacun peut s'ajouter ou se
            // retirer de `hiddenFor`, personne d'autre. Le message reste
            // intact pour l'autre participant.
            || (
              request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['hiddenFor'])
              && request.resource.data.hiddenFor.toSet()
                   .difference(resource.data.get('hiddenFor', []).toSet())
                   .hasOnly([request.auth.uid])
              && resource.data.get('hiddenFor', []).toSet()
                   .difference(request.resource.data.hiddenFor.toSet())
                   .hasOnly([request.auth.uid])
            )
          );
      }

      // Indicateur "en train d'écrire / d'enregistrer" — chacun ne peut
      // écrire que son propre document, lisible par l'autre participant.
      // Lu à la fois par l'en-tête de la discussion et par la liste des
      // conversations (une écoute par conversation visible), donc par un
      // client qui n'a pas forcément la discussion ouverte.
      match /typing/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        // Forme du document verrouillée : c'est du contenu écrit par un
        // tiers que l'app d'en face affiche. Sans ces contraintes, un
        // participant pourrait y déposer un champ `state` arbitraire ou
        // une charge utile de taille libre que l'autre télécharge en
        // continu (rafraîchi toutes les 5 s par le heartbeat).
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && canWriteConversation(conversationId)
          && request.resource.data.keys().hasOnly(['state', 'updatedAt'])
          && request.resource.data.state in ['idle', 'typing', 'recording'];

        allow delete: if request.auth != null
          && request.auth.uid == uid;
      }
    }

    // -----------------------------------------------------------------
    // Appels (signalisation WebRTC — offer/answer SDP + candidats ICE ;
    // le média audio/vidéo ne transite jamais par Firestore)
    // -----------------------------------------------------------------
    match /calls/{callId} {
      // Scindé get/list : pour une requête `list` (CallService._watchIncoming,
      // filtrée uniquement sur `calleeUid`), Firestore refuse d'évaluer une
      // règle référençant un champ non contraint par la requête — ici
      // `callerUid` — avec une erreur "Property callerUid is undefined on
      // object", et donc "permission-denied" sur toute la requête. `get`
      // (lecture d'un document précis par id, ex. watchCall) peut en
      // revanche vérifier les deux champs sans restriction.
      //
      // Appel de groupe (calls.js) : tout membre lit le document ; un invité
      // dont le téléphone sonne le trouve par `ringingUids`.
      allow get: if request.auth != null
        && (request.auth.uid in [resource.data.callerUid, resource.data.calleeUid]
            || request.auth.uid in resource.data.get('memberUids', []));
      allow list: if request.auth != null
        && (request.auth.uid == resource.data.calleeUid
            || request.auth.uid in resource.data.get('ringingUids', []));

      // Seul l'appelant crée le document, à l'état "ringing".
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.callerUid
        && request.resource.data.status == 'ringing'
        && !blockedBetween(request.resource.data.callerUid,
                           request.resource.data.calleeUid);

      // Les champs immuables (participants, type, conversation) ne
      // bougent jamais. Le SDP "offer" n'est écrit que par l'appelant,
      // "answer" que par l'appelé — chacun ne peut agir que sur son
      // propre côté de la poignée de main ; le statut peut être mis à
      // jour par l'un ou l'autre (raccrocher, refuser, accepter).
      allow update: if request.auth != null
        && request.auth.uid in [resource.data.callerUid, resource.data.calleeUid]
        && request.resource.data.callerUid == resource.data.callerUid
        && request.resource.data.calleeUid == resource.data.calleeUid
        && request.resource.data.conversationId == resource.data.conversationId
        && request.resource.data.type == resource.data.type
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['offer', 'answer', 'answeredAt', 'status', 'endedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['offer'])
             || request.auth.uid == resource.data.callerUid)
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['answer', 'answeredAt'])
             || request.auth.uid == resource.data.calleeUid)
        // En groupe, raccrocher ne coupe pas l'appel des autres : le statut
        // n'est plus réglé que par le serveur (settleGroupCall).
        && !(resource.data.get('group', false) == true
             && request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'endedAt']));

      // Appel de groupe : chaque membre ne met à jour que sa propre ligne
      // (`members.{uid}` : décroché, quitté, refusé…) et ne peut que se
      // retirer de `ringingUids`. Les invitations passent par la fonction
      // inviteToCall.
      allow update: if request.auth != null
        && resource.data.get('group', false) == true
        && request.auth.uid in resource.data.memberUids
        && request.auth.uid in resource.data.members
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['members', 'ringingUids'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys()
             .hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid]
             .diff(resource.data.members[request.auth.uid]).affectedKeys()
             .hasOnly(['state', 'at'])
        && request.resource.data.members[request.auth.uid].state
             in ['joined', 'left', 'declined', 'missed', 'busy']
        && request.resource.data.get('ringingUids', [])
             == resource.data.get('ringingUids', []).removeAll([request.auth.uid]);

      // Candidats ICE : chacun ne peut écrire que dans sa propre
      // sous-collection, lisible par les deux participants de l'appel.
      match /callerCandidates/{candidateId} {
        allow read: if request.auth != null
          && request.auth.uid in [
               get(/databases/$(database)/documents/calls/$(callId)).data.callerUid,
               get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid,
             ];
        allow create: if request.auth != null
          && request.auth.uid ==
               get(/databases/$(database)/documents/calls/$(callId)).data.callerUid;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if request.auth != null
          && request.auth.uid in [
               get(/databases/$(database)/documents/calls/$(callId)).data.callerUid,
               get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid,
             ];
        allow create: if request.auth != null
          && request.auth.uid ==
               get(/databases/$(database)/documents/calls/$(callId)).data.calleeUid;
      }
    }

    // -----------------------------------------------------------------
    // Marché (vente & achat)
    // -----------------------------------------------------------------
    match /market/{itemId} {
      allow read: if true;

      // Le numéro du vendeur n'a rien à faire dans ce document : il est
      // lisible par tout le monde, connecté ou non, et une seule requête
      // suffirait à aspirer les numéros de toute la commune. Il vit dans
      // la sous-collection `contact` ci-dessous, et l'app n'écrit plus
      // jamais `sellerPhone`.
      //
      // La règle ne le refuse pourtant pas à la création, et c'est
      // délibéré : les versions de l'app déjà installées, elles, l'y
      // écrivent encore. Les bloquer ici empêcherait purement et
      // simplement de publier depuis un téléphone non mis à jour. C'est
      // `onMarketItemCreated` qui déplace le numéro et l'efface du
      // document public, dans la seconde qui suit la création — reste
      // une fenêtre de quelques secondes, sans commune mesure avec une
      // base de numéros lisible en permanence.
      allow create: if request.auth != null
        && request.resource.data.sellerUid == request.auth.uid;

      // Le vendeur modifie son annonce librement. Un tiers ne peut
      // toucher qu'aux trois compteurs d'intérêt, et d'un seul cran à la
      // fois : sans cette borne, n'importe qui pourrait inscrire un
      // nombre de vues arbitraire et fabriquer une popularité.
      allow update: if request.auth != null
        && resource != null
        && (
          resource.data.sellerUid == request.auth.uid
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['viewsCount', 'contactsCount', 'favoritesCount'])
            && counterStep(resource, request.resource, 'viewsCount', 1)
            && counterStep(resource, request.resource, 'contactsCount', 1)
            && counterStep(resource, request.resource, 'favoritesCount', 0)
          )
        );

      allow delete: if request.auth != null
        && resource.data.sellerUid == request.auth.uid;

      // Numéro de téléphone du vendeur — réservé aux comptes connectés.
      // C'est tout l'intérêt de l'avoir sorti du document public : un
      // visiteur non authentifié voit l'annonce, jamais le numéro, et
      // l'app enregistre qui a demandé le contact (ce qui conditionne le
      // droit de laisser un avis, plus bas).
      match /contact/{docId} {
        allow read: if request.auth != null;
        allow write: if request.auth != null
          && get(/databases/$(database)/documents/market/$(itemId))
               .data.sellerUid == request.auth.uid;
      }
    }

    // -----------------------------------------------------------------
    // Signalements de contenu (App Store Guideline 1.2 — UGC)
    //
    // Écriture seule côté client : personne ne peut relire les
    // signalements, ni savoir qu'un contenu a été signalé, ni retirer
    // le sien. L'id est déterministe (`{type}_{cible}_{signaleur}` —
    // voir ModerationService.report) pour qu'un même utilisateur ne
    // puisse pas gonfler le compteur en signalant en boucle ; on impose
    // donc `create` uniquement, jamais `update`, et on vérifie que le
    // signaleur déclaré est bien l'appelant.
    //
    // La modération lit et traite depuis la console / l'Admin SDK, qui
    // ignore ces règles (voir onReportCreated dans functions/index.js).
    // -----------------------------------------------------------------
    // Un message privé ne peut être signalé que par un participant de la
    // conversation : sans ça, n'importe qui pourrait faire recopier par le
    // serveur (`onReportCreated`) un message qu'il n'a jamais pu lire.
    function canReportTarget(data) {
      let parts = data.targetPath.split('/');
      return (data.targetType != 'message' && data.targetType != 'live')
        || (
          data.targetType == 'message'
          && parts.size() == 4
          && parts[0] == 'conversations'
          && parts[2] == 'messages'
          && request.auth.uid in conversationPeers(parts[1])
        )
        || (
          data.targetType == 'live'
          && parts.size() == 2
          && parts[0] == 'liveSessions'
        );
    }

    match /reports/{reportId} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.targetPath is string
        && request.resource.data.targetPath.size() < 300
        && request.resource.data.targetType in
             ['post', 'comment', 'user', 'marketItem', 'message', 'status',
              'live', 'proListing']
        && request.resource.data.reason in
             ['spam', 'harcelement', 'haine', 'violence', 'nuditeSexuel',
              'fausseInformation', 'arnaque', 'autre']
        && canReportTarget(request.resource.data);
      allow update, delete: if false;
    }

    // Lives — fiche de chaque live (`liveSessions/{liveId}`), tenue par
    // les fonctions startLive/endLive : c'est la cible des signalements.
    // Le direct lui-même vit dans la Realtime Database (database.rules.json).
    match /liveSessions/{liveId} {
      allow read, write: if false;
    }

    // Administrateurs : un document par compte, créé à la main dans la
    // console. Chacun ne peut lire que le sien (c'est ainsi que l'app sait
    // s'il faut montrer l'écran de modération) ; personne ne l'écrit.
    match /admins/{adminUid} {
      allow read: if request.auth != null && request.auth.uid == adminUid;
      allow write: if false;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // File de modération — écrite par `onReportCreated`, lisible des seuls
    // administrateurs. Les décisions passent par la fonction `moderate`,
    // jamais par une écriture directe.
    match /moderationQueue/{entryId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // -----------------------------------------------------------------
    // Configuration app — ex. `config/app.latestVersion`, comparée par
    // NotificationService.checkAppUpdate. Lecture seule côté client,
    // jamais écrite que depuis la console/l'Admin SDK.
    // -----------------------------------------------------------------
    match /config/{docId} {
      allow read: if request.auth != null;
    }

    // Demandes de certification (functions/certification.js) : écrites par
    // le serveur seul, lues par leur auteur. Un administrateur les valide
    // ou les refuse depuis la console (`status`).
    match /certificationRequests/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }
  }
}
