rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -----------------------------------------------------------------
    // Profils utilisateurs
    // -----------------------------------------------------------------
    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.verified == false;

      // Le propriétaire peut modifier son propre profil librement (hors
      // verified/accountType, contrôlés côté admin). Un autre utilisateur
      // ne peut toucher que `followersCount` — c'est le seul champ que
      // follow_service.dart écrit sur le document d'autrui (batch
      // follow/unfollow) ; tout le reste du document doit rester intact.
      allow update: if request.auth != null
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.accountType == resource.data.accountType
        && (
          request.auth.uid == uid
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['followersCount'])
        );

      match /followers/{followerUid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
          && request.auth.uid == followerUid;
      }

      match /following/{targetUid} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null
          && request.auth.uid == uid;
      }
    }

    // -----------------------------------------------------------------
    // Publications (fil d'actualité)
    // -----------------------------------------------------------------
    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid;

      // L'auteur peut modifier son post librement. Un autre utilisateur
      // ne peut toucher qu'aux likes (setLike) et au compteur de
      // commentaires (addComment, appelé par l'auteur du commentaire,
      // pas forcément celui du post) — jamais au titre, corps ou auteur.
      allow update: if request.auth != null
        && (
          resource.data.authorUid == request.auth.uid
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['likedBy', 'likesCount', 'commentsCount'])
        );

      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;

      // Commentaires imbriqués
      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid;

        // L'auteur peut modifier son commentaire librement. Un autre
        // utilisateur ne peut toucher qu'aux likes (setCommentLike).
        allow update: if request.auth != null
          && (
            resource.data.authorUid == request.auth.uid
            || request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['likedBy', 'likesCount'])
          );

        allow delete: if request.auth != null
          && resource.data.authorUid == request.auth.uid;
      }
    }

    // -----------------------------------------------------------------
    // Conversations (chat)
    // -----------------------------------------------------------------
    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && (resource == null || request.auth.uid in resource.data.participants);

      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.participants;

      // Un participant ne peut toucher qu'aux métadonnées de conversation
      // écrites par chat_service.dart (aperçu du dernier message, réglage
      // "éphémère") — jamais à la liste des participants.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.participants
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly([
               'lastMessage', 'lastMessageType', 'lastMessageAt',
               'lastMessageSenderUid', 'ephemeralSeconds',
             ]);

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;

        allow create: if request.auth != null
          && request.resource.data.senderUid == request.auth.uid;

        // Seul l'accusé de lecture (`readAt`) est modifiable après l'envoi
        // — jamais le contenu, l'expéditeur ou le type du message.
        allow update: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['readAt']);
      }
    }

    // -----------------------------------------------------------------
    // Marché (vente & achat)
    // -----------------------------------------------------------------
    match /market/{itemId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.sellerUid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.sellerUid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.sellerUid == request.auth.uid;
    }
  }
}
