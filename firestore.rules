rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // -----------------------------------------------------------------
    // Profils utilisateurs
    // -----------------------------------------------------------------
    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.verified == false;

      allow update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.accountType == resource.data.accountType;
    }

    // -----------------------------------------------------------------
    // Publications (fil d'actualité)
    // -----------------------------------------------------------------
    match /posts/{postId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.authorUid == request.auth.uid;

      allow update: if request.auth != null;

      allow delete: if request.auth != null
        && resource.data.authorUid == request.auth.uid;

      // Commentaires imbriqués
      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid;

        allow update: if request.auth != null;

        allow delete: if request.auth != null
          && resource.data.authorUid == request.auth.uid;
      }
    }

    // -----------------------------------------------------------------
    // Marché (vente & achat)
    // -----------------------------------------------------------------
    match /market/{itemId} {
      allow read: if true;

      allow create: if request.auth != null
        && request.resource.data.sellerUid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.sellerUid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.sellerUid == request.auth.uid;
    }
  }
}
