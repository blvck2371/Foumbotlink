rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images des publications — lecture publique, écriture réservée à
    // l'auteur, **reconnu depuis le chemin**.
    //
    // Le propriétaire tenait auparavant dans une consultation Firestore
    // (`firestore.exists` / `firestore.get` sur `posts/{postId}`). Or les
    // photos partent *avant* la création du document : la règle était
    // évaluée alors que `posts/{postId}` n'existait pas encore, l'appel
    // inter-services échouait et l'envoi était refusé « unauthorized » —
    // le même piège qui avait déjà cassé le premier média d'une nouvelle
    // conversation (voir /chat plus bas). Mettre l'uid dans le chemin
    // supprime la dépendance : plus aucun aller-retour vers Firestore, et
    // la règle ne peut plus échouer parce qu'un document manque.
    match /posts/{authorUid}/{postId}/{fileName} {
      allow read: if true;

      // Photos (10 Mo) ou vidéo (60 Mo, après réduction par l'app au-delà
      // de 8 Mo) — deux plafonds, comme pour les statuts : un seul plafond
      // haut ouvrirait la porte à des « photos » de 60 Mo.
      allow create, update: if request.auth != null
        && request.auth.uid == authorUid
        && (
          (
            request.resource.contentType.matches('image/.*')
            && request.resource.size < 10 * 1024 * 1024
          )
          || (
            request.resource.contentType.matches('video/.*')
            && request.resource.size < 60 * 1024 * 1024
          )
        );

      allow delete: if request.auth != null && request.auth.uid == authorUid;
    }

    // Ancien emplacement, `posts/{postId}/{fileName}` : les photos
    // publiées avant le changement de chemin y restent. Lecture publique
    // pour qu'elles s'affichent toujours dans le fil, et suppression
    // encore permise à l'auteur — il doit pouvoir retirer une vieille
    // photo en éditant son post. Ici la consultation Firestore est sûre :
    // à la suppression, le document existe forcément. Plus aucune
    // écriture n'arrive sur ce chemin.
    match /posts/{postId}/{fileName} {
      allow read: if true;

      allow delete: if request.auth != null
        && firestore.exists(/databases/(default)/documents/posts/$(postId))
        && firestore.get(/databases/(default)/documents/posts/$(postId)).data.authorUid == request.auth.uid;
    }

    // Images du marché — même principe que les publications ci-dessus :
    // le vendeur est lu dans le chemin, jamais dans Firestore.
    match /market/{sellerUid}/{itemId}/{fileName} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == sellerUid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == sellerUid;
    }

    // Photos d'activité de l'annuaire (3 au plus par fiche, limite tenue
    // dans firestore.rules) — le professionnel est lu dans le chemin.
    match /directory/{ownerUid}/{fileName} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.auth.uid == ownerUid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');

      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    // Ancien emplacement des photos d'annonces — voir le commentaire du
    // chemin hérité des publications.
    match /market/{itemId}/{fileName} {
      allow read: if true;

      allow delete: if request.auth != null
        && firestore.exists(/databases/(default)/documents/market/$(itemId))
        && firestore.get(/databases/(default)/documents/market/$(itemId)).data.sellerUid == request.auth.uid;
    }

    // Pièces jointes de chat (vocal, image, document) — réservées aux
    // participants de la conversation. Le conversationId est `uid1_uid2`
    // (uids triés, joints par `_` — voir Conversation.buildId) et les UID
    // Firebase ne contiennent jamais de `_` : on vérifie l'appartenance
    // directement depuis le chemin plutôt que via firestore.get() sur le
    // document de conversation. Ce dernier est créé de façon asynchrone
    // (ChatController._ensureConversation, non attendu) : s'appuyer dessus
    // faisait échouer l'upload du premier média d'une nouvelle
    // conversation (firestore.get renvoie null → règle en erreur → refus
    // "unauthorized").
    //
    // Deux plafonds, comme pour les statuts : une vidéo de quelques
    // dizaines de secondes pèse légitimement plus lourd qu'une photo ou
    // qu'un document, mais un plafond unique à 60 Mo ouvrirait la porte à
    // des « photos » de 60 Mo. Le plafond vidéo est tenu en double côté
    // client (ChatService.maxVideoBytes) pour refuser le fichier avant de
    // le faire monter pour rien.
    // `create, update` et `delete` sont séparés à dessein :
    // `request.resource` est **nul** sur une suppression, si bien qu'une
    // règle unique parlant de `request.resource.size` refusait toute
    // suppression — c'est ce qui faisait échouer en silence le ménage des
    // fichiers joints de `ChatService.deleteMessage`, et ce dont dépend
    // désormais la consommation d'un message à vue unique.
    match /chat/{conversationId}/{allPaths=**} {
      allow read: if request.auth != null
        && request.auth.uid in conversationId.split('_');

      allow create, update: if request.auth != null
        && request.auth.uid in conversationId.split('_')
        && (
          (
            request.resource.contentType.matches('video/.*')
            && request.resource.size < 60 * 1024 * 1024
          )
          || request.resource.size < 20 * 1024 * 1024
        );

      // Supprimer revient à l'un ou l'autre participant : l'expéditeur
      // qui retire son message, le destinataire qui vient de consommer un
      // média à vue unique.
      allow delete: if request.auth != null
        && request.auth.uid in conversationId.split('_');
    }

    // Photos des statuts éphémères — `statuses/{authorUid}/{statusId}.jpg`.
    // L'uid vit dans le chemin, comme pour les publications : la photo
    // part avant que le document Firestore n'existe, une règle qui
    // consulterait `statuses/{statusId}` échouerait donc à la création.
    //
    // Le ménage des fichiers dont le statut a expiré revient à
    // `onStatusDeleted` (Admin SDK), pas au client.
    match /statuses/{authorUid}/{fileName} {
      allow read: if true;

      // Photo ou vidéo, avec deux plafonds distincts : une vidéo de
      // quelques secondes pèse légitimement plus lourd qu'une image, mais
      // un seul plafond haut ouvrirait la porte à des « photos » de 60 Mo.
      allow create, update: if request.auth != null
        && request.auth.uid == authorUid
        && (
          (
            request.resource.contentType.matches('image/.*')
            && request.resource.size < 10 * 1024 * 1024
          )
          || (
            request.resource.contentType.matches('video/.*')
            && request.resource.size < 60 * 1024 * 1024
          )
        );

      allow delete: if request.auth != null && request.auth.uid == authorUid;
    }

    // Photos de profil — lecture publique, écriture limitée au propriétaire
    // (fichier unique `avatar.jpg`, redimensionné côté client avant upload).
    match /profiles/{uid}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
  }
}
