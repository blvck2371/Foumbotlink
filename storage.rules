rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Images des publications — lecture publique, écriture authentifiée
    match /posts/{postId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Images du marché — lecture publique, écriture authentifiée
    match /market/{itemId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
