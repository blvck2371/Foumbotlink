{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "database": {
    "rules": "database.rules.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "*.local"
      ]
    }
  ],
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "foumbotlink",
          "appId": "1:141324093576:android:c547b9e07bd5a9fe88773d",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "ios": {
        "default": {
          "projectId": "foumbotlink",
          "appId": "1:141324093576:ios:54f2ee6b8ee065ae88773d",
          "uploadDebugSymbols": false,
          "fileOutput": "ios/Runner/GoogleService-Info.plist"
        }
      },
      "macos": {
        "default": {
          "projectId": "foumbotlink",
          "appId": "1:141324093576:ios:54f2ee6b8ee065ae88773d",
          "uploadDebugSymbols": false,
          "fileOutput": "macos/Runner/GoogleService-Info.plist"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "foumbotlink",
          "configurations": {
            "android": "1:141324093576:android:c547b9e07bd5a9fe88773d",
            "ios": "1:141324093576:ios:54f2ee6b8ee065ae88773d",
            "macos": "1:141324093576:ios:54f2ee6b8ee065ae88773d",
            "web": "1:141324093576:web:acdc4217391e9a4e88773d",
            "windows": "1:141324093576:web:9c4041f10caacb5988773d"
          }
        }
      }
    }
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "database": {
      "port": 9000
    }
  },
  "hosting": {
    "public": "build/web",
    "predeploy": [
      "flutter build web --release",
      "cp public/confidentialite.html public/securite-enfants.html public/suppression-compte.html public/style.css build/web/"
    ],
    "cleanUrls": true,
    "ignore": [
      "firebase.json",
      "**/.*"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(html|js|json|wasm|otf|ttf)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
