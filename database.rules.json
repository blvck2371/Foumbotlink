{
  "rules": {
    ".read": false,
    ".write": false,

    "lives": {
      ".read": "auth != null",
      ".indexOn": ["hostUid", "startedAt"],
      "$liveId": {
        "hostOnline": {
          ".write": "auth != null && data.exists() && auth.uid === data.parent().child('hostUid').val()",
          ".validate": "newData.isBoolean()"
        },
        "hostSeenAt": {
          ".write": "auth != null && data.exists() && auth.uid === data.parent().child('hostUid').val()",
          ".validate": "newData.isNumber() && newData.val() <= now + 5000"
        },
        "likes": {
          ".write": "auth != null && data.exists() && root.child('liveMembers').child($liveId).child(auth.uid).exists() && !root.child('liveBans').child($liveId).child(auth.uid).exists()",
          ".validate": "newData.isNumber() && newData.val() > data.val() && newData.val() <= data.val() + 30"
        }
      }
    },

    "liveViewers": {
      "$liveId": {
        ".read": "auth != null && root.child('liveMembers').child($liveId).child(auth.uid).exists()",
        "$uid": {
          ".write": "auth != null && auth.uid === $uid && (!newData.exists() || (root.child('lives').child($liveId).exists() && root.child('liveMembers').child($liveId).child($uid).exists()))",
          ".validate": "newData.hasChildren(['name', 'at'])",
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "photo": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "liveComments": {
      "$liveId": {
        ".read": "auth != null && root.child('liveMembers').child($liveId).child(auth.uid).exists()",
        ".indexOn": ["at", "uid"],
        "$commentId": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && root.child('lives').child($liveId).exists() && root.child('liveMembers').child($liveId).child(auth.uid).exists() && !root.child('liveBans').child($liveId).child(auth.uid).exists()) || (data.exists() && !newData.exists() && (data.child('uid').val() === auth.uid || root.child('lives').child($liveId).child('hostUid').val() === auth.uid)))",
          ".validate": "newData.hasChildren(['uid', 'name', 'text', 'at'])",
          "uid": { ".validate": "newData.isString()" },
          "name": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 80" },
          "photo": { ".validate": "newData.isString() && newData.val().length <= 1000" },
          "text": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 200" },
          "at": { ".validate": "newData.val() === now" },
          "$other": { ".validate": false }
        }
      }
    },

    "liveGuests": {
      "$liveId": {
        ".read": "auth != null && root.child('liveMembers').child($liveId).child(auth.uid).exists()"
      }
    },

    "liveMembers": {
      "$liveId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },

    "liveBans": {
      "$liveId": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    }
  }
}
